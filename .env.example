# ==============================================================================
# EXEMPLO DE ARQUIVO DE CONFIGURAÇÃO (.env)
# ==============================================================================
# Renomeie este arquivo para '.env.{}/ambiente' para que o Spring carregue as variáveis
# automaticamente (conforme configurado em application-dev.properties)
# ==============================================================================

# Configurações do Banco de Dados PostgreSQL
# DB_URL=jdbc:postgresql://localhost:5432/votacao
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=dev123

# Se estiver usando Docker-compose para subir o banco:
# POSTGRES_DB=votacao


DB_URL=jdbc:postgresql://localhost:5433/votacao
POSTGRES_DB=votacao
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev123
